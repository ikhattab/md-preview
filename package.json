{
  "name": "md-preview",
  "version": "1.0.0",
  "description": "A fast, private markdown editor with instant live preview",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npx serve -l 3000",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check"
  },
  "devDependencies": {
    "eslint": "^9.16.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.13.0",
    "prettier": "^3.4.2"
  },
  "keywords": [
    "markdown",
    "preview",
    "editor",
    "live"
  ],
  "author": "",
  "license": "MIT"
}
