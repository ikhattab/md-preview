{
  "name": "md-preview",
  "version": "1.0.0",
  "description": "A fast, private markdown editor with instant live preview",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 3000",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "vite": "^8.3.4"
  },
  "keywords": [
    "markdown",
    "preview",
    "editor",
    "live"
  ],
  "author": "Ihab Khattab <ihab@hey.com>",
  "license": "MIT",
  "homepage": "https://mdfor.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ikhattab/md-preview.git"
  },
  "bugs": {
    "url": "https://github.com/ikhattab/md-preview/issues"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.2.9",
    "@fontsource/hanken-grotesk": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "dompurify": "^3.4.17",
    "highlight.js": "^11.11.1",
    "katex": "^0.18.10",
    "lucide": "^1.55.0",
    "marked": "^18.1.1",
    "marked-alert": "2.1.2",
    "marked-footnote": "1.4.0",
    "marked-gfm-heading-id": "4.1.4",
    "marked-highlight": "^2.2.4",
    "marked-katex-extension": "^5.1.13",
    "mermaid": "^12.2.0"
  },
  "overrides": {
    "lodash-es": "^4.18.1"
  }
}
